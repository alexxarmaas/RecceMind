        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logoRecce.png",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD_u_KQBTFQq7fHpN-iiGHiBxVhZmJbl74"
        }
      }
    },
    "plugins": [
      "expo-font"
    ]
